# ───────────────────────────────────────────────────────────────
#  Dipendenze
# ───────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/
jspm_packages/

# ───────────────────────────────────────────────────────────────
#  Artefatti di build e pacchetti
# ───────────────────────────────────────────────────────────────
# dist/ è rigenerabile con `npm run package:chrome|firefox`
dist/
build/
out/
*.zip
*.crx
*.pem
*.xpi

# ───────────────────────────────────────────────────────────────
#  Test e qualità
# ───────────────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
.vitest/

# ───────────────────────────────────────────────────────────────
#  Cache degli strumenti
# ───────────────────────────────────────────────────────────────
.cache/
.parcel-cache/
.eslintcache
.prettiercache
.stylelintcache
*.tsbuildinfo
.npm/

# ───────────────────────────────────────────────────────────────
#  Segreti e configurazione locale
#  Non devono MAI finire in un repository pubblico.
# ───────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.key
*.p12
*.keystore
.npmrc
.netrc
credentials.json
secrets.json

# ───────────────────────────────────────────────────────────────
#  Ambienti di sviluppo
# ───────────────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*~

# ───────────────────────────────────────────────────────────────
#  Sistema operativo
# ───────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini

# ───────────────────────────────────────────────────────────────
#  File temporanei e di lavoro
# ───────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*
*.tmp
*.temp
*.bak
*.orig
tmp/
temp/

# Script usati durante il debug: non fanno parte del progetto.
*.tmp.mjs
*.tmp.js

# Codice della versione 1.3, conservato solo in locale come riferimento
# durante la riscrittura. Non va pubblicato.
.legacy/

# Anteprima generata dagli script di verifica, non è un sorgente.
docs/preview-export.html

# ───────────────────────────────────────────────────────────────
#  NOTA sui file che DEVONO essere versionati
# ───────────────────────────────────────────────────────────────
# - package-lock.json  → installazioni riproducibili
# - assets/fonts/*.woff2 → 300 KB, ma senza di essi le formule
#   matematiche non vengono rese (vedi docs/BUGFIX-KATEX-FONTS.md)
# - assets/styles/katex-fonts.css → generato, ma necessario a runtime
#   e rigenerabile solo con accesso a internet
