{
  "manifest_version": 3,
  "name": "Gemini Chat Exporter",
  "version": "2.0.0",
  "description": "Esporta le risposte di Gemini in PDF con formattazione completa: LaTeX, codice, tabelle, markdown.",
  "permissions": ["storage", "tabs"],
  "background": {
    "service_worker": "src/extension/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/extension/popup/popup.html",
    "default_title": "Gemini Chat Exporter"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["src/extension/content/loader.js"],
      "css": ["assets/styles/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/**", "assets/styles/*.css", "src/extension/viewer/*"],
      "matches": ["https://gemini.google.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; font-src 'self' data:; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
  },
  "host_permissions": ["https://gemini.google.com/*"],
  "optional_host_permissions": ["<all_urls>"]
}
