{
  "name": "gemini-chat-exporter",
  "version": "2.0.0",
  "description": "Estensione browser che esporta le conversazioni di Google Gemini in PDF e Word.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "audit:security": "npm audit --audit-level=moderate",
    "build:fonts": "node scripts/build-katex-fonts.js",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "format": "prettier --write \"**/*.{js,css,html,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,css,html,json,md}\"",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "package:all": "npm run package:chrome && npm run package:firefox",
    "package:chrome": "node scripts/package.js chrome",
    "package:firefox": "node scripts/package.js firefox",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "eslint": "^10.8.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
